{% import "_includes/forms" as forms %}
{% import 'matrix-block-anchor/_macros' as macros %}

{% set allowCustomAnchors = settings.getAllowCustomAnchors(true) %}
<h2>{{ 'Custom Anchor Settings'|t('matrix-block-anchor') }}</h2>

{{ forms.booleanMenuField({
    label: 'Allow Custom Anchors'|t('matrix-block-anchor'),
    instructions: 'Allow users to manually set an anchor instead of using the automatically generated one.'|t('matrix-block-anchor'),
    id: 'allowCustomAnchors',
    name: 'allowCustomAnchors',
    includeEnvVars: true,
    value: settings.allowCustomAnchors,
    warning: config.allowCustomAnchors is defined ? macros.configWarning('allowCustomAnchors') : 'Changing this will break any existing links that point to auto-generated/custom anchors.'|t('matrix-block-anchor'),
    tip: (config.allowCustomAnchors is not defined ? macros.configTip('booleanMenuField')),
}) }}

<hr>

<h2>{{ 'Auto-Generated Anchor Settings'|t('matrix-block-anchor') }}</h2>

{{ forms.autosuggestField({
    label: allowCustomAnchors ? 'Anchor Prefix (fallback)'|t('matrix-block-anchor') : 'Anchor Prefix'|t('matrix-block-anchor'),
    instructions: 'Sets the prefix used for auto-generated anchors. This is also used when no custom anchor is provided.'|t('matrix-block-anchor'),
    id: 'anchorPrefix',
    name: 'anchorPrefix',
    suggestEnvVars: true,
    value: settings.anchorPrefix,
    warning: config.anchorPrefix is defined ? macros.configWarning('anchorPrefix') : 'Changing this will break any existing links that point to auto-generated anchors.'|t('matrix-block-anchor'),
    errors: settings.getErrors('anchorPrefix'),
    tip: (config.anchorPrefix is not defined ? macros.configTip('autosuggestField')),
}) }}

{{ forms.booleanMenuField({
    label: allowCustomAnchors ? 'Use Legacy Separator (disabled because Allow Custom Anchors is true)'|t('matrix-block-anchor') : 'Use Legacy Separator'|t('matrix-block-anchor'),
    instructions: 'Use a dash (-) between the prefix and ID for compatibility with plugin versions v2.x and earlier.'|t('matrix-block-anchor'),
    id: 'useLegacySeparator',
    name: 'useLegacySeparator',
    includeEnvVars: true,
    value: settings.useLegacySeparator,
    warning: (config.useLegacySeparator is defined ? macros.configWarning('useLegacySeparator')),
    tip: (config.useLegacySeparator is not defined ? macros.configTip('booleanMenuField')),
    disabled: allowCustomAnchors,
}) }}

<hr>


<h2>{{ 'Field Usage'|t('matrix-block-anchor') }}</h2>

{% if fieldUsage is empty %}
    <p>{{ 'The Matrix Block Anchor field is not currently used in any fields.'|t('matrix-block-anchor') }}</p>
{% else %}
    <p>{{ 'The Matrix Block Anchor field is used in the following locations:'|t('matrix-block-anchor') }}</p>
    
    {% set groupedUsage = {} %}
    {% for item in fieldUsage %}
        {% set matrixFieldId = 'field_' ~ item.matrixField.id %}
        {% if groupedUsage[matrixFieldId] is not defined %}
            {% set groupedUsage = groupedUsage|merge({
                (matrixFieldId): {
                    matrixField: item.matrixField,
                    matrixFieldUrl: item.matrixFieldUrl,
                    entryTypes: []
                }
            }) %}
        {% endif %}
        {% set currentGroup = groupedUsage[matrixFieldId] %}
        {% set groupedUsage = groupedUsage|merge({
            (matrixFieldId): {
                matrixField: currentGroup.matrixField,
                matrixFieldUrl: currentGroup.matrixFieldUrl,
                entryTypes: currentGroup.entryTypes|merge([{
                    entryType: item.entryType,
                    entryTypeUrl: item.entryTypeUrl
                }])
            }
        }) %}
    {% endfor %}
    
    <ul class="bullets">
        {% for matrixFieldId, data in groupedUsage %}
            <li>
            <a href="{{ data.matrixFieldUrl }}">{{ data.matrixField.name }}</a> (Matrix Field)
            </li>
            {% for entryTypeData in data.entryTypes %}
                <li><a href="{{ entryTypeData.entryTypeUrl }}">{{ entryTypeData.entryType.name }}</a> (Entry Type)</li>
            {% endfor %}
            
            
        {% endfor %}
    </ul>
{% endif %}
