{% import "_includes/forms" as forms %}

<div class="copytext">
   {{ forms.text({
	  class: allowCustomAnchors ? '' : 'disabled',
	  name: name,
	  value: value,
	  disabled: not allowCustomAnchors,
	  instructions: allowCustomAnchors ? 'Enter a unique anchor ID. Must not start with a number or contain spaces.'|t('matrix-block-anchor') : null,
   }) }}
   {{ tag('a', {
	  class: 'btn clip-copy',
	  title: 'Copy to clipboard'|t('matrix-block-anchor'),
	  href: 'javascript:void(0);',
	  aria: {
		 label: 'Copy to clipboard'|t('matrix-block-anchor')
	  },
	  data: {
		 icon: 'clipboard',
	  }
   }) }}
</div>
