{% import "_includes/forms" as forms %}

{% set inputId = field.getInputId() %}

<div class="mba-copytext">
    {{ forms.text({
        id: inputId,
        describedBy: field.describedBy,
        name: name,
        value: value,
        readonly: readonly,
    }) }}
    {{ tag('button', {
        type: 'button',
        class: 'btn mba-copy',
        title: 'Copy to clipboard'|t('matrix-block-anchor'),
        aria: {
            label: 'Copy to clipboard'|t('matrix-block-anchor'),
            controls: inputId,
        },
        data: {
            icon: 'clipboard',
            target: inputId,
        },
    }) }}
</div>
